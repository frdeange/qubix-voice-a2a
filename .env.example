# =============================================================================
# Qubix PoC - environment configuration
# Copy this file to ".env" and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Foundry project (shared by all scripts)
# -----------------------------------------------------------------------------
# Full project endpoint, format: https://{account}.services.ai.azure.com/api/projects/{project}
PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# Account-level endpoint (no /api/projects/...). Used by the Voice Live client.
VOICELIVE_ENDPOINT=https://<your-account>.services.ai.azure.com/

# Short project name (last path segment of PROJECT_ENDPOINT).
PROJECT_NAME=<your-project>

# -----------------------------------------------------------------------------
# Model deployments
# -----------------------------------------------------------------------------
# Text/reasoning model used by the Foundry agents (orchestrator + specialist).
MODEL_DEPLOYMENT_NAME=<your-chat-model-deployment>

# Realtime speech-to-speech model used ONLY by Approach B (model mode).
REALTIME_MODEL=<your-realtime-model-deployment>

# Neural voice used by Voice Live (both approaches).
VOICE_NAME=en-US-Ava:DragonHDLatestNeural

# -----------------------------------------------------------------------------
# Agent names
# -----------------------------------------------------------------------------
ORCHESTRATOR_AGENT_NAME=orchestrator-agent
SPECIALIST_AGENT_NAME=office-specialist-agent

# -----------------------------------------------------------------------------
# Work IQ MCP (specialist agent tool)
# Create the Work IQ connection once in the Foundry portal (Tools > catalog >
# Provider = Microsoft) so the OAuth is handled for you, then fill these in.
# -----------------------------------------------------------------------------
# Remote MCP server URL, e.g. https://agent365.svc.cloud.microsoft/agents/tenants/{tenantId}/servers/mcp_MailTools
WORKIQ_MCP_SERVER_URL=
# Unique label for the MCP server within the agent.
WORKIQ_MCP_SERVER_LABEL=workiq
# Name of the Foundry project connection that stores the Work IQ authentication.
WORKIQ_MCP_CONNECTION_NAME=

# -----------------------------------------------------------------------------
# A2A connection (Approach A only: orchestrator -> specialist)
# Needed to create the RemoteA2A connection through the management plane.
# -----------------------------------------------------------------------------
SUBSCRIPTION_ID=<your-subscription-id>
RESOURCE_GROUP=<your-resource-group>
FOUNDRY_ACCOUNT=<your-foundry-account>
A2A_CONNECTION_NAME=specialist-a2a

# -----------------------------------------------------------------------------
# Optional Voice Live settings
# -----------------------------------------------------------------------------
# AGENT_VERSION=
# CONVERSATION_ID=

# -----------------------------------------------------------------------------
# Web app (webapp/) - MSAL sign-in for the browser
# -----------------------------------------------------------------------------
TENANT_ID=<your-tenant-id>
CLIENT_ID=<your-app-client-id>
# Delegated Work IQ scope the browser requests a token for.
WORKIQ_SCOPE=fdcc1f02-fc51-4226-8753-f668596af7f7/WorkIQAgent.Ask
